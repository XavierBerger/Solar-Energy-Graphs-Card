{
  "name": "solar-energy-graphs-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run --incremental",
    "typecheck": "tsc --noEmit",
    "diagrams": "for f in docs/diagrams/*.mmd; do mmdc --quiet -i \"$f\" -o \"${f%.mmd}.svg\" -c docs/diagrams/mermaid.json -p docs/diagrams/puppeteer.json -b white || exit 1; done"
  },
  "dependencies": {
    "lit": "^3.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}