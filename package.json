{
  "name": "solar-energy-graphs-card",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run --incremental",
    "typecheck": "tsc --noEmit",
    "diagrams": "for f in docs/diagrams/*.mmd; do mmdc --quiet -i \"$f\" -o \"${f%.mmd}.svg\" -c docs/diagrams/mermaid.json -p docs/diagrams/puppeteer.json -b white || exit 1; done"
  },
  "dependencies": {
    "lit": "^3.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  }
}